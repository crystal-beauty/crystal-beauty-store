generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ TEAM / AUTH ============

model TeamMember {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("STAFF") // OWNER | ADMIN | STAFF
  avatarUrl    String?
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ============ CATALOG ============

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id               String      @id @default(cuid())
  name             String
  slug             String      @unique
  sku              String?
  shortDescription String?
  description      String?
  price            Float // DZD whole numbers
  comparePrice     Float? // optional old price — only shown when admin sets it
  costPrice        Float?
  weightGrams      Int         @default(500) // for carrier / future use
  stock            Int         @default(0)
  trackStock       Boolean     @default(true)
  active           Boolean     @default(true)
  featured         Boolean     @default(false)
  media            String      @default("[]") // JSON [{type:'image'|'video', url, alt}]
  categoryId       String?
  category         Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants         Variant[]
  orderItems       OrderItem[]
  reviews          Review[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

// Variant = option group (e.g. "Size"), VariantOption = choice (e.g. "Large" +500 DA)
model Variant {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  required  Boolean         @default(true)
  sortOrder Int             @default(0)
  options   VariantOption[]
}

model VariantOption {
  id            String  @id @default(cuid())
  variantId     String
  variant       Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  label         String
  priceModifier Float   @default(0)
  hexColor      String?
  stock         Int?
  sortOrder     Int     @default(0)
}

// ============ PROMOTIONS ============

model PromoCode {
  id        String    @id @default(cuid())
  code      String    @unique
  type      String    @default("PERCENT") // PERCENT | FIXED
  value     Float
  minOrder  Float     @default(0)
  maxUses   Int?
  usedCount Int       @default(0)
  expiresAt DateTime?
  active    Boolean   @default(true)
  orders    Order[]
  createdAt DateTime  @default(now())
}

// ============ ORDERS (COD / Algeria) ============

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  status            String      @default("NEW") // NEW|CONFIRMED|SENT_TO_CARRIER|IN_DELIVERY|DELIVERED|REFUSED|RETURNED|CANCELLED
  customerName      String
  email             String? // optional
  phone             String // 05/06/07…
  // Algerian delivery address
  wilayaId          Int?
  wilayaName        String
  commune           String
  address           String // ≤ 30 chars (waybill printer constraint)
  deliveryType      String      @default("HOME") // HOME | STOP_DESK
  stopDeskName      String?
  notes             String?
  // Gift options
  giftMessage       String?
  recipientName     String?
  recipientPhone    String?
  // Money — DZD whole numbers
  subtotal          Float
  discount          Float       @default(0)
  deliveryFee       Float       @default(0) // quoted from carrier API, saved at order time
  giftBoxFee        Float       @default(0)
  total             Float // COD amount = products + delivery (carrier rounding: whole DA)
  currency          String      @default("DZD")
  promoCodeId       String?
  promoCode         PromoCode?  @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  promoCodeStr      String?
  // Carrier (World Express / EcoTrack)
  carrier           String?
  trackingNumber    String?
  carrierStatus     String? // raw carrier status
  globalStatus      String? // raw global_status
  shipmentResponse  String?
  sentToCarrierAt   DateTime?
  deliveredAt       DateTime?
  reviewRequestedAt DateTime?
  statusHistory     String      @default("[]") // JSON [{status, at, by}]
  pixelEventId      String?
  items             OrderItem[]
  review            Review?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName       String
  productImage      String?
  variantSelections String   @default("{}") // JSON {"Size":"Large"}
  unitPrice         Float
  quantity          Int
  lineTotal         Float
  giftBox           Boolean  @default(false)
}

// ============ REVIEWS (real only — one per delivered order, admin-approved) ============

model Review {
  id           String    @id @default(cuid())
  orderId      String    @unique
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  token        String    @unique // one-time review link
  customerName String
  wilayaName   String
  rating       Int       @default(0) // 1..5, filled on submit
  text         String    @default("")
  approved     Boolean   @default(false) // admin approves → visible on store
  submitted    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ============ BLOCKED PHONES ============

model BlockedPhone {
  id        String   @id @default(cuid())
  phone     String   @unique // normalized (digits, last 9 match)
  reason    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ============ CARRIER CACHE (wilaya/commune/fees lists) ============

model CarrierCache {
  key       String   @id
  payload   String
  expiresAt DateTime
}

// ============ SETTINGS (everything changeable) ============

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ============ META PIXEL EVENT LOG ============

model PixelEvent {
  id        String   @id @default(cuid())
  eventName String
  eventId   String?
  payload   String?
  source    String   @default("browser") // browser | server
  forwarded Boolean  @default(false)
  createdAt DateTime @default(now())
}
